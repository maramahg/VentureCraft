# Firebase client config used by the Next.js app.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin config used by server routes and E2E Firestore verification.
FIREBASE_CLIENT_EMAIL=your_service_account_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"

# Vercel Blob upload token used by the upload route.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token

# Local-only form preview toggle.
# Keep this false or unset in production.
NEXT_PUBLIC_ENABLE_FORM_PREVIEW=false

# Playwright E2E test account.
# Use a disposable test account from a staging project when possible.
E2E_USER_EMAIL=your-test-user@example.com
E2E_USER_PASSWORD=your-test-user-password

# Optional Playwright settings.
PLAYWRIGHT_PORT=3100
PLAYWRIGHT_SLOW_MO=250

# Optional integrations.
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_key

