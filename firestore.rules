rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if the user is in the 'admins' or 'super_admins' collection
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isSuperAdmin()
      );
    }

    // Helper: Check if the user is in the 'super_admins' collection
    function isSuperAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid));
    }

    // Helper: Check if the user is in the 'judges' collection
    function isJudge() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/judges/$(request.auth.uid));
    }

    // Helper: Get judge data safely
    function getJudgeData() {
      return get(/databases/$(database)/documents/judges/$(request.auth.uid)).data;
    }

    // Helper: Check if judge is Ultimate
    function isUltimateJudge() {
      return isJudge() && (
        getJudgeData().get('role', '') == 'ultimate' || 
        getJudgeData().get('team', '') == ''
      );
    }

    // Helper: Check if judge is Supervisor
    function isSupervisor() {
      return isJudge() && getJudgeData().get('role', '') == 'supervisor';
    }

    // Helper: Check if judge belongs to a specific team
    function isTeamJudge(teamId) {
      let r = getJudgeData().get('role', '');
      return isJudge() && 
             getJudgeData().get('team', '') == teamId && 
             (r == 'team_judge' || r == 'Technical' || r == 'Business' || r == 'technical' || r == 'business' || r == 'tech' || r == 'bus');
    }

    // Helper: Check if the user is in the 'ambassadors_lead' collection
    function isAmbassadorLead() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/ambassadors_lead/$(request.auth.uid));
    }

    // Helper: Check if the user is in the 'outreach_leaders' collection
    function isOutreachLead() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/outreach_leaders/$(request.auth.uid));
    }

    // Helper: Check if the user can manage ambassadors
    function isAmbassadorManager() {
      return isAdmin() || isAmbassadorLead() || isOutreachLead();
    }

    // Helper: Registration Status
    function isRegistrationOpen() {
      let reg = get(/databases/$(database)/documents/settings/registration).data;
      return reg.get('isOpen', true) == true || reg.get('isAllowed', true) == true;
    }

    // Helper: Editing Allowed
    function isEditingAllowed() {
      let edit = get(/databases/$(database)/documents/settings/editing).data;
      return edit.get('isOpen', true) == true || edit.get('isAllowed', true) == true;
    }
    
    // Outreach Participants
    match /outreach_participants/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || isAmbassadorLead() || isOutreachLead());
    }

    // Counters (Internal tracking)
    match /counters/{docId} {
      allow read: if request.auth != null;
      allow write: if isAmbassadorManager();
    }

    // Startup Applications
    match /applications/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == docId || 
        (resource != null && request.auth.uid == resource.data.userId) || 
        isAdmin() || 
        isUltimateJudge() || 
        (isJudge() && resource != null && resource.data.get('assignedTeam', '') == get(/databases/$(database)/documents/judges/$(request.auth.uid)).data.get('team', ''))
      );
      allow create: if request.auth != null 
        && (isRegistrationOpen() || isAdmin());
      allow update: if request.auth != null 
        && (
          request.auth.uid == docId || 
          request.auth.uid == resource.data.userId || 
          isAdmin() || 
          isJudge()
        ) 
        && (
          // If modifying screening data, MUST be Admin or Judge
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['screening'])) ||
          isAdmin() ||
          isJudge()
        )
        && (isEditingAllowed() || isRegistrationOpen() || isAdmin() || isJudge());
      allow delete: if isAdmin();
    }

    // Ambassador Applications
    match /ambassador_applications/{docId} {
      allow read: if request.auth != null && (isAmbassadorManager() || request.auth.uid == docId || (resource != null && request.auth.uid == resource.data.userId));
      allow write: if request.auth != null && (isAmbassadorManager() || request.auth.uid == docId || (resource != null && request.auth.uid == resource.data.userId));
      allow delete: if request.auth != null && isAmbassadorManager();
      allow create: if request.auth != null;
    }

    // Ambassadors Collection (Public Profiles)
    match /ambassadors/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAmbassadorManager());
      // Allow point increments for referrals
      allow update: if request.auth != null 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points'])
        && request.resource.data.points == resource.data.points + 10;
    }

    // Users Collection (Profiles)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAmbassadorManager() || isJudge());
      allow write: if request.auth != null && (request.auth.uid == userId || isAmbassadorManager());
      allow create: if request.auth != null;
      // Allow point increments for referrals
      allow update: if request.auth != null 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points'])
        && request.resource.data.points == resource.data.points + 10;

      // Point History Sub-collection
      match /point_history/{historyId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAmbassadorManager());
        allow write: if isAmbassadorManager();
        // Allow automatic referral logging
        allow create: if request.auth != null && request.resource.data.type == 'referral';
      }
    }

    // System Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || (isUltimateJudge() && docId == 'screeningRound2');
    }

    // Judges Collection
    match /judges/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isJudge());
      allow write: if isAdmin();
    }

    // Role verification collections
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    match /ambassadors_lead/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    match /outreach_leaders/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    match /super_admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

  }
}
