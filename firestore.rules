rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if the user is in the 'admins' collection
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: Check if the user is in the 'judges' collection
    function isJudge() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/judges/$(request.auth.uid));
    }

    // Helper: Check if the user is in the 'ambassadors_lead' collection
    function isAmbassadorLead() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/ambassadors_lead/$(request.auth.uid));
    }

    // Helper: Check if startup registration is open
    function isRegistrationOpen() {
      return get(/databases/$(database)/documents/settings/registration).data.isOpen == true;
    }

    // Helper: Check if editing is allowed
    function isEditingAllowed() {
      return get(/databases/$(database)/documents/settings/editing).data.isOpen == true;
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Judges Collection
    match /judges/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Ambassador Leads Collection
    match /ambassadors_lead/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Startup Applications
    match /applications/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin() || isJudge());
      allow create: if request.auth != null && (isRegistrationOpen() || isAdmin());
      allow update: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin() || isJudge()) && (isEditingAllowed() || isAdmin());
      allow delete: if isAdmin();
    }

    // Ambassador Applications
    match /ambassador_applications/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin() || isAmbassadorLead());
      allow write: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin() || isAmbassadorLead());
      allow delete: if request.auth != null && (isAdmin() || isAmbassadorLead());
      allow create: if request.auth != null;
    }

    // Ambassadors Collection (Public Profiles)
    match /ambassadors/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin() || isAmbassadorLead());
      // Allow point increments for referrals
      allow update: if request.auth != null 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points'])
        && request.resource.data.points == resource.data.points + 10;
    }

    // Users Collection (Profiles)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isAmbassadorLead() || isJudge());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin() || isAmbassadorLead());
      allow create: if request.auth != null;
      // Allow point increments for referrals
      allow update: if request.auth != null 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points'])
        && request.resource.data.points == resource.data.points + 10;

      // Point History Sub-collection
      match /point_history/{historyId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isAmbassadorLead());
        allow write: if isAdmin() || isAmbassadorLead();
        // Allow automatic referral logging
        allow create: if request.auth != null && request.resource.data.type == 'referral';
      }
    }

    // System Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Counters (Internal tracking)
    match /counters/{docId} {
      allow read, write: if isAdmin() || isAmbassadorLead();
    }

  }
}
