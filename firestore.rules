rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if the user is in the 'admins' collection
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Admins Collection
    match /admins/{userId} {
      // Allow any logged-in user to read their own admin record to verify status
      allow read: if request.auth != null && request.auth.uid == userId;
      // Admins can read all admin records
      allow read: if isAdmin();
      // Writing to admins is restricted to Console only for security
      allow write: if false;
    }
    // Startup Applications
    match /applications/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null;
    }
    // Ambassador Applications
    match /ambassador_applications/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null;
    }
    // Users Collection (Profiles)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    // System Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
